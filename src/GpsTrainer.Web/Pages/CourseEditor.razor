    private void SyncElevation()
    {
        var measured = ElevationProfile.GainLoss(waypoints);
        course.AltitudeGainKm = measured.GainKm;
        course.AltitudeLossKm = measured.LossKm;
    }

    private async Task Save()
    {
        if (Session.Login is null)
        {
            message = "Sign in first.";
            return;
        }
        if (string.IsNullOrWhiteSpace(course.Name))
            course.Name = "Untitled course";
        SyncElevation();
        var saved = await Api.SaveCourseAsync(course, creating);
        if (saved is null)
        {
            message = "The course was not saved.";
            return;
        }
        creating = false;
        course.CourseId = saved.CourseId;
        var savedWaypoints = true;
        if (waypoints.Count > 0)
        {
            if (waypoints.All(wp => wp.ElapsedDistanceKm == 0))
            {
                var distance = 0.0;
                GeoPosition? previous = null;
                foreach (var wp in waypoints)
                {
                    var here = new GeoPosition(wp.Latitude, wp.Longitude, false);
                    if (previous is not null)
                        distance += previous.DistanceTo(here).ToKilometers().Value;
                    wp.ElapsedDistanceKm = distance;
                    previous = here;
                }
                course.ElapsedDistanceKm = distance;
            }
            else
                course.ElapsedDistanceKm = waypoints.Max(wp => wp.ElapsedDistanceKm);
            savedWaypoints = await Api.SaveWaypointsAsync(course.CourseId, waypoints);
            await Api.SaveCourseAsync(course);
        }
        var raceId = await Api.GenerateRaceAsync(course.CourseId, goalTime);
        await ClearDraft();
        var savedText = savedWaypoints ? "Saved." : "Course saved, waypoints were not.";
        message = savedText + (raceId == Guid.Empty ? " A goal race was not created." : " A goal race was created.");
    }

    public async ValueTask DisposeAsync()
    {
        await RememberDraft();
        try
        {
            await Js.InvokeVoidAsync("gpsTrainerDialogs.unwatch");
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        try
        {
            await Map.UnmountAsync();
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        UnhookMap();
        self?.Dispose();
    }

    private void HookMap()
    {
        if (mapEventsHooked)
            return;
        Map.MapClicked += OnMapClicked;
        Map.PinDragged += OnPinDragged;
        Map.InsertRequested += OnInsertRequested;
        Map.DeleteRequested += OnDeleteRequested;
        Map.ConnectRequested += OnConnectRequested;
        Map.TypeChangeRequested += OnTypeChangeRequested;
        Map.IntervalRequested += OnIntervalRequested;
        Map.StandardFinishRequested += OnStandardFinishRequested;
        Map.TextChangeRequested += OnTextChangeRequested;
        Map.SummitRequested += OnSummitRequested;
        Map.SummitAtRequested += OnSummitAtRequested;
        Map.ProfilePlaceRequested += OnProfilePlaceRequested;
        Map.ProfileIntervalRequested += OnProfileIntervalRequested;
        Map.LoopCloseRequested += OnLoopCloseRequested;
        Map.UndoRequested += OnUndoRequested;
        mapEventsHooked = true;
    }

    private void UnhookMap()
    {
        if (!mapEventsHooked)
            return;
        Map.MapClicked -= OnMapClicked;
        Map.PinDragged -= OnPinDragged;
        Map.InsertRequested -= OnInsertRequested;
        Map.DeleteRequested -= OnDeleteRequested;
        Map.ConnectRequested -= OnConnectRequested;
        Map.TypeChangeRequested -= OnTypeChangeRequested;
        Map.IntervalRequested -= OnIntervalRequested;
        Map.StandardFinishRequested -= OnStandardFinishRequested;
        Map.TextChangeRequested -= OnTextChangeRequested;
        Map.SummitRequested -= OnSummitRequested;
        Map.SummitAtRequested -= OnSummitAtRequested;
        Map.ProfilePlaceRequested -= OnProfilePlaceRequested;
        Map.ProfileIntervalRequested -= OnProfileIntervalRequested;
        Map.LoopCloseRequested -= OnLoopCloseRequested;
        Map.UndoRequested -= OnUndoRequested;
        mapEventsHooked = false;
    }

    private Task OnMapClicked(GeoCoord point) => AddWaypoint(point.Latitude, point.Longitude);

    private Task OnPinDragged(int index, GeoCoord point) => MoveWaypoint(index, point.Latitude, point.Longitude);

    private Task OnInsertRequested(string typeName, GeoCoord point, bool route) =>
        InsertWaypoint(typeName, point.Latitude, point.Longitude, route);

    private Task OnDeleteRequested(int index) => DeleteWaypoint(index);

    private Task OnConnectRequested(int selectedIndex, int targetIndex, string typeName) =>
        ConnectWaypoint(selectedIndex, targetIndex, typeName);

    private Task OnTypeChangeRequested(int index, string typeName) => SetWaypointType(index, typeName);

    private Task OnIntervalRequested(int index, string distance) => PlaceInterval(index, distance);

    private Task OnStandardFinishRequested(int index, GeoCoord point) =>
        StandardFinish(index, point.Latitude, point.Longitude);

    private Task OnTextChangeRequested(int index, string text) => SetWaypointText(index, text);

    private Task OnSummitRequested(int index) => PlaceSummit(index);

    private Task OnSummitAtRequested(GeoCoord point) => PlaceSummitAt(point.Latitude, point.Longitude);

    private Task OnProfilePlaceRequested(string kind, double clientX, double clientY) =>
        ProfilePlace(kind, clientX, clientY);

    private Task OnProfileIntervalRequested(string distance, double clientX, double clientY) =>
        ProfileInterval(distance, clientX, clientY);

    private Task OnLoopCloseRequested() => CloseLoop();

    private Task OnUndoRequested() => UndoLastSegment();
