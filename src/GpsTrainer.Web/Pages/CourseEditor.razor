    public async Task CloseLoop()
    {
        var start = LoopClose.Start(waypoints);
        var last = sketch.LastRoutePoint();
        if (start is null || last is null)
        {
            message = "Add a start before closing the loop.";
            return;
        }
        if (!LoopClose.HasOpenLoop(waypoints))
        {
            message = "The course already finishes at the start.";
            return;
        }
        var before = waypoints.Count;
        sketch.AddClick(start.Latitude, start.Longitude, WaypointType.Finish, followRoads: true, await ClosingRoute(last, start));
        if (waypoints.Count <= before)
        {
            message = "The course already finishes at the start.";
            await RefreshMap();
            return;
        }
        LoopClose.Publish(course, waypoints);
        message = "Loop closed at the start.";
        await RefreshMap();
    }

    /// <summary>
    /// Follow roads from the last point toward the start. If the start pin is off
    /// the road, search again with a wider snap, then pin the end to the exact start.
    /// A real routing failure still closes with a straight segment and no error.
    /// </summary>
    private async Task<RouteResponseDto> ClosingRoute(Waypoint from, Waypoint start)
    {
        RouteResponseDto? route = null;
        if (RoutingLimits.RejectSegment(from.Latitude, from.Longitude, start.Latitude, start.Longitude) is null)
        {
            route = await Api.RouteAsync(ClosingRequest(from, start, snapMeters: null));
            if (LoopClose.NeedsWiderSnap(route))
                route = await Api.RouteAsync(ClosingRequest(from, start, LoopClose.CloseSnapMeters));
        }

        if (route is { Routed: true, Points.Count: > 0 })
        {
            route.Points = LoopClose.PinEndToStart(route.Points, start.Latitude, start.Longitude);
            return route;
        }

        return new RouteResponseDto
        {
            Routed = false,
            StraightFallback = true,
            Message = "Loop closed at the start."
        };
    }

    private RouteRequestDto ClosingRequest(Waypoint from, Waypoint start, double? snapMeters) => new()
    {
        FromLatitude = from.Latitude,
        FromLongitude = from.Longitude,
        ToLatitude = start.Latitude,
        ToLongitude = start.Longitude,
        Activity = ActivityName(),
        SnapRadiusMeters = snapMeters
    };

    private async Task<bool> AddAt(double latitude, double longitude, WaypointType type, bool? forceRoads = null)
    {
        var roads = forceRoads ?? true;
        RouteResponseDto? route = null;
        var previous = sketch.LastRoutePoint();
        var interval = type is WaypointType.StartInterval or WaypointType.FinishInterval;
        if (roads && !interval && previous is not null)
        {
            var rejected = RoutingLimits.RejectSegment(previous.Latitude, previous.Longitude, latitude, longitude);
            if (rejected is not null && !RoutingLimits.AllowsStraightFallback(rejected))
            {
                message = rejected;
                StateHasChanged();
                return false;
            }
            route = await Api.RouteAsync(new RouteRequestDto
            {
                FromLatitude = previous.Latitude,
                FromLongitude = previous.Longitude,
                ToLatitude = latitude,
                ToLongitude = longitude,
                Activity = ActivityName()
            });
        }
        var before = waypoints.Count;
        sketch.AddClick(latitude, longitude, type, roads, route);
        message = sketch.Notice;
        await RefreshMap();
        return waypoints.Count > before;
    }

    public async Task UndoLastSegment()
    {
        if (!sketch.Undo())
        {
            message = "Nothing to undo.";
            StateHasChanged();
            return;
        }
        message = "Removed the last segment.";
        await RefreshMap();
    }

    private async Task ExportGpx()
    {
        string? xml = null;
        if (course.CourseId != Guid.Empty)
            xml = await Api.ExportGpxAsync(course.CourseId);
        xml ??= GpxCourse.Export(string.IsNullOrWhiteSpace(course.Name) ? "course" : course.Name, waypoints, IntervalCourse.FromMarkers(course.CourseId, waypoints));
        await Map.DownloadAsync((string.IsNullOrWhiteSpace(course.Name) ? "course" : course.Name) + ".gpx", xml);
    }

    private async Task ImportGpx(InputFileChangeEventArgs change)
    {
        if (Session.Login is null)
        {
            message = "Sign in before importing.";
            return;
        }
        await using var stream = change.File.OpenReadStream(GpxCourse.MaxCharacters);
        using var reader = new StreamReader(stream);
        var xml = await reader.ReadToEndAsync();
        var preview = await Api.PreviewGpxAsync(xml, change.File.Name, toleranceMeters);
        if (preview is null)
        {
            message = "GPX was not imported.";
            return;
        }
        var keptId = course.CourseId;
        course = preview.Course;
        course.CourseId = keptId;
        course.Login = Session.Login;
        course.Publish = false;
        sketch.Replace(preview.Waypoints);
        message = "Review the imported course, then save. " + course.Comments;
        await RefreshMap();
    }

    private CourseMapFrame Frame()
    {
        var finish = CourseEdits.StandardFinishMenuLabel(CourseEdits.LengthKm(waypoints), metric);
        return new CourseMapFrame
        {
            Center = new GeoCoord(centerLat, centerLon),
            Pins = waypoints.Select((waypoint, index) => new CoursePin(
                index, waypoint.Latitude, waypoint.Longitude, waypoint.WaypointType, waypoint.TextDescription)).ToList(),
            Menus = new CourseMapMenus
            {
                StandardFinish = finish,
                NearStartMeters = LoopClose.NearStartMeters,
                SamePointMeters = RoutePath.SamePointMeters,
                IntervalDistances = CourseEdits.IntervalDistances,
                PinTypes = WaypointMenus.PinMenuTypes.Select(type => new MenuChoice(type.ToString(), WaypointMenus.Label(type))).ToList(),
                Connect = CourseEdits.ConnectTypes.Select(type => new MenuChoice(type.ToString(), WaypointMenus.Label(type))).ToList(),
                MapMenuLast = Rows(true, finish),
                MapMenuEarlier = Rows(false, finish)
            }
        };
    }

    private static List<MenuRow> Rows(bool lastPointSelected, string standardFinish) =>
        MapContextMenu.For(lastPointSelected, standardFinish)
            .Select(row => new MenuRow(row.Label, row.Action, row.Type))
            .ToList();

    private async Task ZoomToAddress()
    {
        if (string.IsNullOrWhiteSpace(zoomAddress))
        {
            message = "Enter an address to zoom to.";
            return;
        }
        var found = await Api.GeocodeAsync(zoomAddress);
        if (!found.Found)
        {
            message = string.IsNullOrWhiteSpace(found.Message) ? "That address was not found." : found.Message;
            return;
        }
        try
        {
            await Map.SetViewAsync(new GeoCoord(found.Latitude, found.Longitude));
            message = "Zoomed to the address.";
        }
        catch (JSException)
        {
            message = "The map is not ready.";
        }
    }

    private async Task FinishEdit(CourseEdit edit, string success)
    {
        if (!edit.Ok)
        {
            message = edit.Message ?? "That edit was not applied.";
            StateHasChanged();
            return;
        }
        var notice = await RerouteGaps(edit.Gaps);
        message = notice ?? success;
        await RefreshMap();
    }

    private async Task<string?> RerouteGaps(IReadOnlyList<RouteGap> gaps)
    {
        if (gaps.Count == 0)
            return null;
        string? notice = null;
        foreach (var gap in gaps)
        {
            var from = waypoints.FirstOrDefault(point => point.TimestampTicks == gap.FromTicks);
            var to = waypoints.FirstOrDefault(point => point.TimestampTicks == gap.ToTicks);
            if (from is null || to is null)
                continue;
            var rejected = RoutingLimits.RejectSegment(from.Latitude, from.Longitude, to.Latitude, to.Longitude);
            if (rejected is not null && !RoutingLimits.AllowsStraightFallback(rejected))
            {
                notice = rejected;
                continue;
            }
            var route = await Api.RouteAsync(new RouteRequestDto
            {
                FromLatitude = from.Latitude,
                FromLongitude = from.Longitude,
                ToLatitude = to.Latitude,
                ToLongitude = to.Longitude,
                Activity = ActivityName()
            });
            if (route is { Routed: true, Points.Count: > 0 })
            {
                sketch.SpliceRoute(gap.FromTicks, gap.ToTicks, route);
                continue;
            }
            var text = string.IsNullOrWhiteSpace(route?.Message) ? "Routing failed." : route.Message.Trim();
            notice = text.Contains("straight", StringComparison.OrdinalIgnoreCase)
                ? text
                : text.TrimEnd('.') + ". A straight segment was kept.";
        }
        return notice;
    }

    private async Task RefreshMap()
    {
