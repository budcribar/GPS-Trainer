<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS is part of the project and builds on macOS (or with -p:IncludeIos=true). Linux CI builds the Android head only. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(IncludeIos)' == 'true' OR $([MSBuild]::IsOSPlatform('OSX'))">net10.0-android;net10.0-ios</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>GpsTrainer.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name. A side-by-side test build overrides -p:ApplicationTitle. -->
		<ApplicationTitle>gpsTrainer</ApplicationTitle>

		<!-- Play listing for com.peakSwc.gpsTrainer was removed in 2018 and rejects new uploads.
		     This id is the new app on every platform. A test build can still override -p:ApplicationId. -->
		<ApplicationId>com.peakswc.gpstrainer.app</ApplicationId>

		<!-- Empty uses the platform default (the live server on Android). -p:DefaultApiBaseUrl=https://host replaces it for a test APK. -->
		<DefaultApiBaseUrl Condition="'$(DefaultApiBaseUrl)' == ''"></DefaultApiBaseUrl>

		<!-- versionName / versionCode. Raise ApplicationVersion for every Play upload. -->
		<ApplicationDisplayVersion>1.46</ApplicationDisplayVersion>
		<ApplicationVersion>146</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- Play automatic protection requires min SDK 24 (Android 7.0). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<!-- Play requires target API 36 for new apps and updates as of 31 Aug 2026. -->
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</TargetPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Release Android package. Signing comes from MSBuild properties or environment variables.
	     AndroidSigningKeyStore, AndroidSigningKeyAlias, AndroidSigningStorePass, AndroidSigningKeyPass
	     or GPSTRAINER_ANDROID_KEYSTORE, GPSTRAINER_ANDROID_KEY_ALIAS, GPSTRAINER_ANDROID_STORE_PASS, GPSTRAINER_ANDROID_KEY_PASS.
	     Never commit a keystore or a password. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidPackageFormats>aab</AndroidPackageFormats>
		<AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)' == '' AND '$(GPSTRAINER_ANDROID_KEYSTORE)' != ''">$(GPSTRAINER_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' == '' AND '$(GPSTRAINER_ANDROID_KEY_ALIAS)' != ''">$(GPSTRAINER_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
		<AndroidSigningStorePass Condition="'$(AndroidSigningStorePass)' == '' AND '$(GPSTRAINER_ANDROID_STORE_PASS)' != ''">$(GPSTRAINER_ANDROID_STORE_PASS)</AndroidSigningStorePass>
		<AndroidSigningKeyPass Condition="'$(AndroidSigningKeyPass)' == '' AND '$(GPSTRAINER_ANDROID_KEY_PASS)' != ''">$(GPSTRAINER_ANDROID_KEY_PASS)</AndroidSigningKeyPass>
		<AndroidKeyStore Condition="'$(AndroidSigningKeyStore)' != ''">True</AndroidKeyStore>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<!-- Android uses hand-authored adaptive layers under Platforms/Android/Resources.
		     MauiIcon would scale the full artwork into the mask and crop it. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#F4F8FB" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B3D6A" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\GpsTrainer.Shared\GpsTrainer.Shared.csproj" />
	  <Using Include="GpsTrainer" />
	</ItemGroup>

	<ItemGroup Condition="'$(DefaultApiBaseUrl)' != ''">
		<Compile Remove="ApiAddress.BuiltIn.cs" />
	</ItemGroup>

	<Target Name="GenerateApiBaseUrl" BeforeTargets="CoreCompile" Condition="'$(DefaultApiBaseUrl)' != ''">
		<Exec Command="python3 &quot;$(MSBuildProjectDirectory)/write_api_base.py&quot; &quot;$(IntermediateOutputPath)ApiBaseUrl.g.cs&quot; &quot;$(DefaultApiBaseUrl)&quot;" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)ApiBaseUrl.g.cs" />
		</ItemGroup>
	</Target>

</Project>
